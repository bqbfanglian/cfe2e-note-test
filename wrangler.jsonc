{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfe2e-note-test",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false },
    "issues": { "enabled": false }
  },
  "logpush": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfe2e-note",
      // Deploy to Cloudflare fills in the database ID for the target account.
      "database_id": "4834928b-ae48-4cf1-94f0-d1c8b6e3d63f"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "862769147",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}

