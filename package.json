{
  "name": "cfe2e-note-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "test": "node --test"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "填写至少 32 个随机字符作为网页门禁密码。加密主密码在网页解锁时单独输入。"
      }
    }
  },
  "devDependencies": {
    "wrangler": "^4.55.0"
  }
}

